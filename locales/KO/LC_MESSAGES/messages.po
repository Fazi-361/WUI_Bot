#: bot/handlers/info.py:44
msgid "command.info.usage"
msgstr "Insert the title's ID, name or checksum (crc, md5, sha1) after the commmand. E.g.:\n"
"<pre>/info ST7E01</pre>\n"
"<pre>/info Super Mario Galaxy</pre>\n"
"<pre>/info fb84bfc5</pre>\n"
"<pre>/info LNA-CTR-AREE-USA</pre>\n"
"Note: channels do not need the final two characters"

